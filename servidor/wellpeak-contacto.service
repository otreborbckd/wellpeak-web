[Unit]
Description=WellPeak - formulario de contacto
After=network.target

[Service]
Type=simple
User=wellpeak
WorkingDirectory=/srv/wellpeak/servidor
EnvironmentFile=/etc/wellpeak/contacto.env
ExecStart=/usr/bin/node /srv/wellpeak/servidor/contacto.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
